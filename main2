                (navn, handling, pygame.Rect(
                    int(BREDDE * 0.09), int(HOYDE * 0.55) + i * 68, 420, 54
                ))
                for i, (navn, handling) in enumerate(valg)
            ]

        if skjermnavn == "pause":
            valg = (
                ("Fortsett", "fortsett"),
                ("Start på nytt", "omstart"),
                ("Hovedmeny", "meny")
            )
            return [
                (navn, handling, pygame.Rect(
                    self.pauseboks.left + 42,
                    self.pauseboks.top + 124 + i * 67,
                    self.pauseboks.width - 84, 52
                ))
                for i, (navn, handling) in enumerate(valg)
