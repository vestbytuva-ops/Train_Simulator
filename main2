                19, UI_HVIT, True, anker="center"
            )
            self.tegn_knapp(
                skjerm, "Ny tur", self.nyknapp,
                valgt=self.nyknapp.collidepoint(self.mus), liten=True
            )
            self.tegn_knapp(
                skjerm, "Pause", self.pauseknapp,
                valgt=self.pauseknapp.collidepoint(self.mus), liten=True
            )
        else:
            self.tegn_meny(skjerm)

        if skjermer[-1] == "pause":
            self.tegn_pause(skjerm)
        elif skjermer[-1] == "hjelp":
            self.tegn_hjelp(skjerm)


class Spill:
    def __init__(self):
        pygame.init()
        info = pygame.display.Info()
        skala = min(
            1100 / BREDDE,
            max(640, info.current_w - 80) / BREDDE,
            max(400, info.current_h - 100) / HOYDE
        )
        vindusstorrelse = (round(BREDDE * skala), round(HOYDE * skala))
        self.vindu = pygame.display.set_mode(vindusstorrelse, pygame.RESIZABLE)
        pygame.display.set_caption("Train Simulator")
        self.lerret = pygame.Surface((BREDDE, HOYDE))
        self.klokke = pygame.time.Clock()

        self.bakgrunn = Bakgrunn()
        self.bane = Bane()
        self.gui = Grensesnitt()
        self.kjorer = True
        self.skjermer = ["meny"]
        self.ny_tur()

    def ny_tur(self):
        self.tog = Tog("Lokomotiv 1", 20000)
        self.kamera = Kamera()
        self.akkumulator = 0.0
        self.synlig_posisjon = 0.0

        self.tog.abonner(self.gui.panel.motta_data)
        self.tog.varsle_data(self.bane)

        bilde = self.tog.bilde.copy()
        self.tog.tegn_hjul(bilde, 0)
        self.gui.sett_togbilde(bilde)

    def visningsrektangel(self):
        bredde, hoyde = self.vindu.get_size()
        skala = min(bredde / BREDDE, hoyde / HOYDE)
        r = pygame.Rect(
            0, 0, max(1, round(BREDDE * skala)),
            max(1, round(HOYDE * skala))
        )
        r.center = (bredde // 2, hoyde // 2)
        return r

    def musposisjon(self, posisjon):
        r = self.visningsrektangel()
        if not r.collidepoint(posisjon):
            return (-1000, -1000)
        x, y = posisjon
        return (
            (x - r.left) * BREDDE / r.width,
            (y - r.top) * HOYDE / r.height
        )

    def sett_pause(self):
        if self.skjermer[-1] == "spill":
            self.skjermer.append("pause")
            self.gui.valg["pause"] = 0
            self.akkumulator = 0.0
            self.tog.gi_gass(False)
            self.tog.brems(False)
            self.tog.varsle_data(self.bane)

    def handling(self, handling):
        if handling in ("start", "omstart"):
            self.ny_tur()
            self.skjermer = ["spill"]
        elif handling == "fortsett":
            if self.skjermer[-1] == "pause":
                self.skjermer.pop()
            self.akkumulator = 0.0
        elif handling == "pause":
            self.sett_pause()
        elif handling == "meny":
            self.skjermer = ["meny"]
            self.gui.valg["meny"] = 0
            self.tog.gi_gass(False)
            self.tog.brems(False)
            self.tog.varsle_data(self.bane)
            self.akkumulator = 0.0
        elif handling == "hjelp":
            self.skjermer.append("hjelp")
            self.gui.valg["hjelp"] = 0
        elif handling == "tilbake":
            if len(self.skjermer) > 1:
                self.skjermer.pop()
        elif handling == "avslutt":
            self.kjorer = False

    def handter_hendelse(self, hendelse):
        if hendelse.type == pygame.QUIT:
            self.kjorer = False
            return
        if hendelse.type == pygame.VIDEORESIZE:
            if hendelse.w > 0 and hendelse.h > 0:
                self.vindu = pygame.display.set_mode(
                    (hendelse.w, hendelse.h), pygame.RESIZABLE
                )
            return
        if hendelse.type == pygame.WINDOWFOCUSLOST:
            self.sett_pause()
            return

        skjermnavn = self.skjermer[-1]
        knapper = self.gui.knapper(skjermnavn)

        if hendelse.type == pygame.KEYDOWN:
            if hendelse.key == pygame.K_ESCAPE:
                if skjermnavn == "spill":
                    self.sett_pause()
                elif skjermnavn == "pause":
                    self.handling("fortsett")
                elif skjermnavn == "hjelp":
                    self.handling("tilbake")
                return

            if skjermnavn == "spill":
                if hendelse.key == pygame.K_p:
                    self.sett_pause()
                elif hendelse.key == pygame.K_r:
                    self.handling("omstart")
                return

            if skjermnavn == "pause" and hendelse.key == pygame.K_p:
                self.handling("fortsett")
                return

            if knapper:
                if hendelse.key in (pygame.K_DOWN, pygame.K_s):
                    self.gui.valg[skjermnavn] = (
                        self.gui.valg[skjermnavn] + 1
                    ) % len(knapper)
                elif hendelse.key in (pygame.K_UP, pygame.K_w):
                    self.gui.valg[skjermnavn] = (
                        self.gui.valg[skjermnavn] - 1
                    ) % len(knapper)
                elif hendelse.key in (pygame.K_RETURN, pygame.K_SPACE):
                    self.handling(knapper[self.gui.valg[skjermnavn]][1])

        elif hendelse.type in (pygame.MOUSEMOTION, pygame.MOUSEBUTTONDOWN):
            posisjon = self.musposisjon(hendelse.pos)
            self.gui.mus = posisjon

            if skjermnavn == "spill":
                if hendelse.type == pygame.MOUSEBUTTONDOWN and hendelse.button == 1:
                    if self.gui.pauseknapp.collidepoint(posisjon):
                        self.sett_pause()
                    elif self.gui.nyknapp.collidepoint(posisjon):
                        self.handling("omstart")
            else:
                for i, (navn, handling, rektangel) in enumerate(knapper):
                    if rektangel.collidepoint(posisjon):
                        self.gui.valg[skjermnavn] = i
                        if (hendelse.type == pygame.MOUSEBUTTONDOWN
                                and hendelse.button == 1):
                            self.handling(handling)
                        break

    def oppdater(self, frame_dt, taster=None):
        if self.skjermer[-1] != "spill":
            return

        if taster is None:
            taster = pygame.key.get_pressed()

        self.tog.gi_gass(taster[pygame.K_RIGHT] or taster[pygame.K_d])
        self.tog.brems(taster[pygame.K_LEFT] or taster[pygame.K_a])

        self.akkumulator += min(frame_dt, 0.1)
        while self.akkumulator >= FYSIKK_DT:
            self.tog.oppdater(FYSIKK_DT, self.bane)
            self.akkumulator -= FYSIKK_DT

        andel = self.akkumulator / FYSIKK_DT
        self.synlig_posisjon = self.tog.interpolert_posisjon(andel)
        self.kamera.oppdater(self.synlig_posisjon, self.bane)

    def tegn(self):
        self.bakgrunn.tegn(self.lerret, self.kamera)
        self.bane.tegn(self.lerret, self.kamera, self.synlig_posisjon)
        self.tog.tegn(
            self.lerret, self.kamera, self.bane, self.synlig_posisjon
        )
        self.gui.tegn(self.lerret, self.skjermer)

        r = self.visningsrektangel()
        self.vindu.fill((5, 10, 17))
        bilde = pygame.transform.smoothscale(self.lerret, r.size)
        self.vindu.blit(bilde, r)
        pygame.display.flip()

    def kjor(self):
        try:
            while self.kjorer:
                frame_dt = self.klokke.tick(60) / 1000
                for hendelse in pygame.event.get():
                    self.handter_hendelse(hendelse)
                if not self.kjorer:
                    break
                self.oppdater(frame_dt)
                self.tegn()
        finally:
            pygame.quit()


if __name__ == "__main__":
    Spill().kjor()

