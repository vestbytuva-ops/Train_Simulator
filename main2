    def tegn(self, skjerm, skjermer):
        if "spill" in skjermer:
            self.panel.tegn(skjerm)
            brand = pygame.Rect(20, 20, 246, 52)
            tegn_kort(skjerm, brand, UI_BAKGRUNN, 12)
            self.tekst.tegn(
