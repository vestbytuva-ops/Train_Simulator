import pygame
from collections import OrderedDict
from bisect import bisect_right
from math import atan2, cos, degrees, hypot, pi, sin, tan


BREDDE = 1200
HOYDE = 760
PIKSLER_PER_METER = 5
START_X = 100
SKINNE_Y = 450

TYNGDEAKSELERASJON = 9.81
FYSIKK_DT = 1 / 120


class Bakgrunn:
    def __init__(self):
        self.sky_bilde = self.lag_sky()
        self.skyer = ((70, 75), (380, 110), (690, 65))

        self.fjerne_fjell = (
            (0, 350), (90, 275), (145, 305),
            (240, 170), (310, 235), (360, 215),
            (470, 315), (540, 280), (600, 350)
        )

        self.naere_fjell = (
            (0, 385), (100, 325), (180, 345),
            (310, 255), (400, 315), (500, 285),
            (650, 350), (730, 330), (800, 385)
        )

    def lag_sky(self):
        bilde = pygame.Surface((130, 60), pygame.SRCALPHA)
        hvit = (245, 250, 255)

        pygame.draw.circle(bilde, hvit, (32, 35), 19)
        pygame.draw.circle(bilde, hvit, (55, 28), 24)
        pygame.draw.circle(bilde, hvit, (85, 30), 22)
        pygame.draw.ellipse(bilde, hvit, (15, 32, 100, 25))

        return bilde

    def tegn_fjellag(self, skjerm, kamera, profil, farge, faktor):
        periode = profil[-1][0]
        forskyvning = (kamera.x * faktor) % periode

        # Gjenta fjellprofilen slik at bakgrunnen fortsetter.
        for runde in range(-1, BREDDE // periode + 2):
            start_x = runde * periode - forskyvning
            punkter = []

            for x, y in profil:
                punkter.append((round(start_x + x), y))

            punkter.extend([
                (round(start_x + periode), HOYDE),
                (round(start_x), HOYDE)
            ])

            pygame.draw.polygon(skjerm, farge, punkter)

    def tegn(self, skjerm, kamera):
        skjerm.fill((145, 205, 235))

        # Solen ligger langt unna og holder samme skjermposisjon.
        pygame.draw.circle(
            skjerm, (255, 235, 160), (760, 90), 28
        )

        # Skyene beveger seg svært langsomt med kameraet.
        periode = BREDDE + 200

        for start_x, y in self.skyer:
            x = (
                (start_x - kamera.x * 0.08 + 150)
                % periode
            ) - 150

            skjerm.blit(self.sky_bilde, (round(x), y))

        # Fjerne fjell beveger seg mindre enn de nærmere fjellene.
        self.tegn_fjellag(
            skjerm, kamera,
            self.fjerne_fjell, (120, 165, 190), 0.15
        )

        self.tegn_fjellag(
            skjerm, kamera,
            self.naere_fjell, (85, 140, 155), 0.30
        )


class Bane:
    def __init__(self):
        self.flat_lengde = 80
        self.bakke_bredde = 320
        self.bakke_hoyde = 12

        self.punkter = []
        self.avstander = [0.0]

        for x in range(0, self.bakke_bredde + 1, 2):
            hoyde = self.bakke_hoyde * (
                1 - cos(2 * pi * x / self.bakke_bredde)
            ) / 2

            self.punkter.append((x, hoyde))

            if len(self.punkter) > 1:
                forrige_x, forrige_hoyde = self.punkter[-2]

                lengde = hypot(
                    x - forrige_x,
                    hoyde - forrige_hoyde
                )

                self.avstander.append(
                    self.avstander[-1] + lengde
                )

        self.bakke_lengde = self.avstander[-1]

    def punkt(self, posisjon):
        if posisjon <= self.flat_lengde:
            return posisjon, 0.0

        rest = posisjon - self.flat_lengde

        runde = int(rest // self.bakke_lengde)
        lokal_posisjon = rest % self.bakke_lengde

        i = bisect_right(self.avstander, lokal_posisjon) - 1
        i = min(i, len(self.punkter) - 2)

        andel = (
            (lokal_posisjon - self.avstander[i])
            / (self.avstander[i + 1] - self.avstander[i])
        )

        x1, h1 = self.punkter[i]
        x2, h2 = self.punkter[i + 1]

        x = x1 + (x2 - x1) * andel
        hoyde = h1 + (h2 - h1) * andel

        verden_x = (
            self.flat_lengde
            + runde * self.bakke_bredde
            + x
        )

        return verden_x, hoyde

    def vinkel(self, posisjon):
        x1, h1 = self.punkt(posisjon - 0.5)
        x2, h2 = self.punkt(posisjon + 0.5)

        return atan2(h2 - h1, x2 - x1)

    def skjermpunkt(self, posisjon, kamera):
        x, hoyde = self.punkt(posisjon)

        skjerm_x = START_X + x * PIKSLER_PER_METER - kamera.x
        skjerm_y = SKINNE_Y - hoyde * PIKSLER_PER_METER

        return round(skjerm_x), round(skjerm_y)

    def tegn(self, skjerm, kamera, tog_posisjon):
        start = int(tog_posisjon // 2) * 2 - 80
        slutt = start + int(BREDDE / PIKSLER_PER_METER) + 180
        punkter = []

        for posisjon in range(start, slutt, 2):
            punkter.append(
                self.skjermpunkt(posisjon, kamera)
            )

        terreng = punkter + [
            (punkter[-1][0], HOYDE),
            (punkter[0][0], HOYDE)
        ]

        pygame.draw.polygon(
            skjerm, (75, 155, 75), terreng
        )

        start_sviller = int(start // 8) * 8

        for posisjon in range(start_sviller, slutt, 8):
            x, y = self.skjermpunkt(posisjon, kamera)

            pygame.draw.rect(
                skjerm,
                (110, 80, 45),
                (x - 10, y, 20, 8)
            )

        pygame.draw.lines(
            skjerm, (70, 70, 70), False, punkter, 4
        )


class Tog:
    def __init__(self, navn, masse):
        self.navn = navn
        self.masse = masse

        # Forenklede øvingsverdier.
        self.motorkraft = 40000
        self.motoreffekt = 350000
        self.bremsekraft = 80000
        self.rullemotstand = 1500
        self.luftmotstand_faktor = 8

        self.gass = 0
        self.bremsing = 0

        self.fart = 0.0
        self.posisjon = 0.0
        self.forrige_posisjon = 0.0
        self.distanse = 0.0
        self.observere = []
        self._siste_data = None

        self.hjulradius = 8
        self.hjulsentre = ((22, 37), (98, 37))
        self.bilde = self.lag_bilde()

    def lag_bilde(self):
