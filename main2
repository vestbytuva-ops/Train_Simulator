            (120, 45), pygame.SRCALPHA
        )

        rod = (205, 55, 55)
        mork = (40, 45, 50)

        pygame.draw.rect(bilde, mork, (7, 29, 108, 6))

        pygame.draw.rect(
            bilde, rod, (10, 16, 70, 16),
            border_radius=3
        )

        pygame.draw.rect(
            bilde, rod, (78, 3, 32, 29),
            border_radius=3
        )

        pygame.draw.rect(bilde, mork, (76, 1, 36, 4))

        pygame.draw.rect(
            bilde, mork, (81, 6, 24, 14),
            border_radius=2
        )

        pygame.draw.rect(
            bilde, (135, 205, 225), (83, 8, 20, 10)
        )

        pygame.draw.line(
            bilde, mork, (94, 8), (94, 17), 1
        )

        pygame.draw.rect(
            bilde, (245, 215, 140), (11, 28, 98, 3)
        )

        for x in range(20, 68, 8):
            pygame.draw.line(
                bilde, mork, (x, 20), (x, 26), 2
            )

        pygame.draw.rect(bilde, mork, (42, 11, 6, 5))
        pygame.draw.rect(bilde, mork, (41, 9, 8, 3))

        pygame.draw.rect(bilde, mork, (1, 29, 6, 3))
        pygame.draw.rect(bilde, mork, (115, 29, 5, 3))

        pygame.draw.circle(
            bilde, (255, 240, 170), (110, 24), 2
        )

        return bilde

    def tegn_hjul(self, bilde, posisjon):
        radius_i_meter = self.hjulradius / PIKSLER_PER_METER
        hjulvinkel = posisjon / radius_i_meter

        for x, y in self.hjulsentre:
            pygame.draw.circle(
                bilde, (25, 28, 31),
                (x, y), self.hjulradius
            )

            pygame.draw.circle(
                bilde, (110, 115, 120),
                (x, y), self.hjulradius - 2
            )

            for forskyvning in (0, 2 * pi / 3, 4 * pi / 3):
                vinkel = hjulvinkel + forskyvning

                ende_x = round(
                    x + cos(vinkel) * (self.hjulradius - 2)
                )

                ende_y = round(
                    y + sin(vinkel) * (self.hjulradius - 2)
                )

                pygame.draw.line(
                    bilde, (40, 45, 50),
                    (x, y), (ende_x, ende_y), 2
                )

            pygame.draw.circle(
                bilde, (185, 190, 195), (x, y), 2
            )

    def abonner(self, callback):
        self.observere.append(callback)

    def varsle_data(self, bane):
        # Panelet får beskjed bare når de synlige dataene endres.
        retning = "STILLE"
        if self.fart > 0.01:
            retning = "FREMOVER"
        elif self.fart < -0.01:
            retning = "BAKOVER"

        kraft = self.beregn_motorkraft()
        data = {
            "navn": self.navn,
            "fart": round(abs(self.fart) * 3.6, 1),
            "retning": retning,
            "distanse": round(self.distanse),
            "posisjon": round(self.posisjon),
            "helning": round(tan(bane.vinkel(self.posisjon)) * 100, 1),
            "motorkraft": round(kraft / 1000, 1),
            "effekt": round(max(0, kraft * self.fart) / 1000),
            "gass": round(self.gass * 100),
            "brems": round(self.bremsing * 100),
            "masse": self.masse / 1000,
            "makseffekt": self.motoreffekt / 1000
        }

        if data != self._siste_data:
            self._siste_data = data
            for callback in self.observere:
                callback(data.copy())

    def gi_gass(self, aktiv):
        self.gass = 1 if aktiv else 0

    def brems(self, aktiv):
        self.bremsing = 1 if aktiv else 0

    def beregn_motorkraft(self):
        if self.gass == 0:
            return 0.0

        fart = max(abs(self.fart), 0.1)
        kraft_fra_effekt = self.motoreffekt / fart

        tilgjengelig_kraft = min(
            self.motorkraft,
            kraft_fra_effekt
        )

        return tilgjengelig_kraft * self.gass

    def beregn_motstand(self):
        luftmotstand = self.luftmotstand_faktor * self.fart ** 2
        return self.rullemotstand + luftmotstand

    def oppdater(self, dt, bane):
        self.forrige_posisjon = self.posisjon
        vinkel = bane.vinkel(self.posisjon)

        kraft_motor = self.beregn_motorkraft()

        kraft_bakke = (
            -self.masse
            * TYNGDEAKSELERASJON
            * sin(vinkel)
        )

        drivkraft = kraft_motor + kraft_bakke

        motkraft = (
            self.beregn_motstand()
            + self.bremsekraft * self.bremsing
        )

        if abs(self.fart) < 0.001:
            if abs(drivkraft) <= motkraft:
                self.fart = 0.0
                self.varsle_data(bane)
                return

            retning = 1 if drivkraft > 0 else -1
        else:
            retning = 1 if self.fart > 0 else -1

        samlet_kraft = drivkraft - retning * motkraft
        akselerasjon = samlet_kraft / self.masse
        ny_fart = self.fart + akselerasjon * dt

        if self.fart * ny_fart < 0:
            ny_fart = 0.0

        self.fart = ny_fart

        flytting = self.fart * dt
        self.posisjon += flytting
        self.distanse += abs(flytting)
        self.varsle_data(bane)

    def interpolert_posisjon(self, andel):
        return (
            self.forrige_posisjon
            + (self.posisjon - self.forrige_posisjon) * andel
        )

    def tegn(self, skjerm, kamera, bane, posisjon):
        bilde = self.bilde.copy()
        self.tegn_hjul(bilde, posisjon)

        skinne_x, skinne_y = bane.skjermpunkt(
            posisjon, kamera
        )

        vinkel = bane.vinkel(posisjon)

        rotert_bilde = pygame.transform.rotate(
            bilde, degrees(vinkel)
        )

        halv_hoyde = self.bilde.get_height() / 2

        senter_x = skinne_x - sin(vinkel) * halv_hoyde
        senter_y = skinne_y - cos(vinkel) * halv_hoyde

        rektangel = rotert_bilde.get_rect(
            center=(round(senter_x), round(senter_y))
        )

        skjerm.blit(rotert_bilde, rektangel)


class Kamera:
    def __init__(self):
        self.x = 0.0

    def oppdater(self, posisjon, bane):
        verden_x, hoyde = bane.punkt(posisjon)

        tog_x = START_X + verden_x * PIKSLER_PER_METER
        skjerm_x = tog_x - self.x

        if skjerm_x > 300:
            self.x = tog_x - 300
        elif skjerm_x < 100:
            self.x = tog_x - 100



# Farger brukes av både meny og instrumentpanel.
UI_BAKGRUNN = (17, 30, 44)
UI_KORT = (28, 46, 64)
UI_KANT = (55, 77, 95)
UI_HVIT = (239, 246, 250)
UI_DEMPET = (163, 184, 198)
UI_AKSENT = (112, 230, 203)
UI_ORANSJE = (255, 190, 112)


def tall(verdi, desimaler=1):
    return f"{verdi:.{desimaler}f}".replace(".", ",")


class Tekstcache:
    def __init__(self):
        self.fonter = {}
        self.bilder = OrderedDict()

    def font(self, storrelse, fet=False):
        nokkel = (storrelse, fet)
        if nokkel not in self.fonter:
            self.fonter[nokkel] = pygame.font.SysFont(
                ("segoeui", "dejavusans", "arial"), storrelse, bold=fet
            )
        return self.fonter[nokkel]

    def bilde(self, tekst, storrelse, farge=UI_HVIT, fet=False,
              maks_bredde=None):
        if maks_bredde:
            while (storrelse > 10
                   and self.font(storrelse, fet).size(tekst)[0] > maks_bredde):
                storrelse -= 1

        nokkel = (tekst, storrelse, farge, fet)
        if nokkel in self.bilder:
            self.bilder.move_to_end(nokkel)
            return self.bilder[nokkel]

        bilde = self.font(storrelse, fet).render(tekst, True, farge)
        self.bilder[nokkel] = bilde

        # Begrens minnebruk under lange turer.
        if len(self.bilder) > 384:
            self.bilder.popitem(last=False)
        return bilde

    def tegn(self, skjerm, tekst, posisjon, storrelse=18, farge=UI_HVIT,
             fet=False, anker="topleft", maks_bredde=None):
        bilde = self.bilde(
            tekst, storrelse, farge, fet, maks_bredde
        )
        rektangel = bilde.get_rect(**{anker: posisjon})
        skjerm.blit(bilde, rektangel)
        return rektangel


def tegn_kort(skjerm, rektangel, farge=UI_KORT, radius=16, kant=True):
    pygame.draw.rect(
        skjerm, farge, rektangel, border_radius=radius
    )
    if kant:
        pygame.draw.rect(
            skjerm, UI_KANT, rektangel, 1, border_radius=radius
        )


class Instrumentpanel:
    def __init__(self, tekst):
        self.tekst = tekst
        self.data = {}
        self.rektangel = pygame.Rect(20, HOYDE - 236, BREDDE - 40, 216)

        # Fordel kortene i en rad inne i panelet.
        mellomrom = 14
        tilgjengelig = self.rektangel.width - 40 - 4 * mellomrom
        x = self.rektangel.left + 20
        self.kort = []

        for andel in (0.235, 0.19, 0.17, 0.17, 0.235):
            kort = pygame.Rect(
                x, self.rektangel.top + 44,
                int(tilgjengelig * andel), 138
            )
            self.kort.append(kort)
            x = kort.right + mellomrom

    def motta_data(self, data):
        # GUI-en får data gjennom en melding fra Tog.
        self.data = data

    def metrikk(self, skjerm, kort, tittel, verdi, enhet,
                undertittel, farge=UI_HVIT):
        t = self.tekst
        t.tegn(skjerm, tittel, (kort.left + 16, kort.top + 12),
               13, UI_DEMPET, True, maks_bredde=kort.width - 32)
        t.tegn(skjerm, verdi, (kort.left + 16, kort.top + 37),
               36, farge, True, maks_bredde=kort.width - 32)
        t.tegn(skjerm, enhet, (kort.left + 16, kort.top + 83),
               14, UI_DEMPET)
        t.tegn(skjerm, undertittel,
               (kort.left + 16, kort.bottom - 26),
               12, UI_DEMPET, maks_bredde=kort.width - 32)

    def indikator(self, skjerm, kort, navn, prosent, y, farge):
        t = self.tekst
        t.tegn(skjerm, navn, (kort.left + 16, y), 14)
        t.tegn(skjerm, f"{prosent} %", (kort.right - 16, y),
               14, farge, True, anker="topright")

        spor = pygame.Rect(kort.left + 16, y + 23, kort.width - 32, 8)
        pygame.draw.rect(skjerm, (11, 24, 37), spor, border_radius=4)
        fyll = spor.copy()
        fyll.width = round(spor.width * prosent / 100)
        if fyll.width > 0:
            pygame.draw.rect(skjerm, farge, fyll, border_radius=4)

    def tegn(self, skjerm):
        if not self.data:
            return

        d = self.data
        t = self.tekst
        p = self.rektangel
        pygame.draw.rect(
            skjerm, (10, 21, 31), p.move(0, 5), border_radius=20
        )
        tegn_kort(skjerm, p, UI_BAKGRUNN, 20)

        t.tegn(skjerm, d["navn"].upper(), (p.left + 20, p.top + 15),
               14, UI_HVIT, True)
        t.tegn(
            skjerm,
            f'{tall(d["masse"])} t  /  {tall(d["makseffekt"], 0)} kW',
            (p.right - 20, p.top + 15), 14, UI_DEMPET, anker="topright"
        )

        for kort in self.kort:
            tegn_kort(skjerm, kort)

        fartkort, distansekort, bakkekort, motorkort, kontrollkort = self.kort

        t.tegn(skjerm, "FART", (fartkort.left + 16, fartkort.top + 12),
               13, UI_DEMPET, True)

        fartbilde = t.bilde(
            tall(d["fart"]), 52, UI_HVIT, True, fartkort.width - 70
        )
        skjerm.blit(fartbilde, (fartkort.left + 16, fartkort.top + 33))
        enhet_x = min(
            fartkort.right - 49,
            fartkort.left + 24 + fartbilde.get_width()
        )
        t.tegn(skjerm, "km/t", (enhet_x, fartkort.top + 72), 14, UI_DEMPET)

        farge = UI_DEMPET if d["retning"] == "STILLE" else UI_AKSENT
        if d["retning"] == "BAKOVER":
            farge = UI_ORANSJE
        status = pygame.Rect(fartkort.left + 16, fartkort.bottom - 33, 112, 23)
        pygame.draw.rect(skjerm, (17, 34, 47), status, border_radius=11)
        t.tegn(skjerm, d["retning"], status.center,
               12, farge, True, anker="center")

        distanse = d["distanse"]
        if distanse >= 1000:
            verdi, enhet = tall(distanse / 1000, 2), "km"
        else:
            verdi, enhet = tall(distanse, 0), "meter"
        self.metrikk(
            skjerm, distansekort, "KJØRT DISTANSE", verdi, enhet,
            f'Posisjon {tall(d["posisjon"], 0)} m'
        )

        helning = d["helning"]
        beskrivelse = "Flatt"
        bakkefarge = UI_HVIT
        if helning > 0.1:
            beskrivelse, bakkefarge = "Oppover", UI_ORANSJE
        elif helning < -0.1:
            beskrivelse, bakkefarge = "Nedover", UI_AKSENT

        self.metrikk(
            skjerm, bakkekort, "HELNING", tall(helning), "%",
            beskrivelse, bakkefarge
        )
        self.metrikk(
            skjerm, motorkort, "MOTORKRAFT", tall(d["motorkraft"]), "kN",
            f'Effekt {tall(d["effekt"], 0)} kW'
        )

        t.tegn(
            skjerm, "GASS / BREMS",
            (kontrollkort.left + 16, kontrollkort.top + 12),
            13, UI_DEMPET, True
        )
        self.indikator(
            skjerm, kontrollkort, "Gass", d["gass"],
            kontrollkort.top + 32, UI_AKSENT
        )
        self.indikator(
            skjerm, kontrollkort, "Brems", d["brems"],
            kontrollkort.top + 73, UI_ORANSJE
        )
        t.tegn(
            skjerm, "Hold høyre / venstre",
            (kontrollkort.left + 16, kontrollkort.bottom - 25),
            12, UI_DEMPET
        )

        t.tegn(skjerm, "Høyre / D: gass   ·   Venstre / A: brems",
               (p.left + 20, p.bottom - 23), 13, UI_DEMPET)
        t.tegn(skjerm, "Esc / P: pause   ·   R: ny tur",
               (p.right - 20, p.bottom - 23), 13, UI_DEMPET,
               anker="topright")


class Grensesnitt:
    def __init__(self):
        self.tekst = Tekstcache()
        self.panel = Instrumentpanel(self.tekst)
        self.valg = {"meny": 0, "pause": 0, "hjelp": 0}
        self.mus = (-1000, -1000)
        self.togbilde = None

        self.menyslor = pygame.Surface((BREDDE, HOYDE), pygame.SRCALPHA)
        self.menyslor.fill((8, 17, 28, 182))
        self.pauseslor = pygame.Surface((BREDDE, HOYDE), pygame.SRCALPHA)
        self.pauseslor.fill((6, 13, 23, 172))

        self.pauseboks = pygame.Rect(0, 0, 460, 424)
        self.pauseboks.center = (BREDDE // 2, HOYDE // 2)
        self.hjelpeboks = pygame.Rect(0, 0, 700, 530)
        self.hjelpeboks.center = (BREDDE // 2, HOYDE // 2)

        self.pauseknapp = pygame.Rect(BREDDE - 132, 20, 112, 44)
        self.nyknapp = pygame.Rect(self.pauseknapp.left - 154, 20, 142, 44)

    def sett_togbilde(self, bilde):
        self.togbilde = pygame.transform.smoothscale(bilde, (320, 120))

